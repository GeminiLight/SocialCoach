                "en": "Your manager"
              },
              "personality": {
                "zh": "客气但强势，习惯用「大家都在拼」施压；对于有替代方案的拒绝能接受。",
                "en": "Courteous but pushy; leans on 'everyone's pulling their weight'; accepts a no that comes with an alternative."
              },
              "stance": {
                "zh": "明早前必须交付，谁做无所谓。",
                "en": "The deck must ship by morning; who does it doesn't matter."
              },
              "hidden": {
                "zh": "其实客户只要先看前三页。",
                "en": "The client really only needs the first three slides tomorrow."
              },
              "hue": 25
            }
          ],
          "objectives": [
            {
              "zh": "清楚说「今晚不行」，不过度解释也不道歉三次。",
              "en": "Say a clear no for tonight without over-explaining or triple apologizing."
            },
            {
              "zh": "提出一个真正可行的替代方案。",
              "en": "Offer a genuinely workable alternative."
            },
            {
              "zh": "弄清楚客户明早真正需要什么。",
              "en": "Find out what the client actually needs tomorrow."
            }
          ],
          "success": {
            "zh": "Michael 接受方案，你今晚按时离开。",
            "en": "Michael accepts the plan and you leave on time."
          },
          "failure": {
            "zh": "你答应留下，或对话变得对立。",
            "en": "You agree to stay, or the exchange turns adversarial."
          },
          "maxTurns": 8,
