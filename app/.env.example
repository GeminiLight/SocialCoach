# ── LLM credentials ─────────────────────────────────────────────
# Either ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN is read by the Anthropic SDK.
ANTHROPIC_API_KEY=
# Optional: custom gateway / proxy base URL (leave empty for api.anthropic.com)
ANTHROPIC_BASE_URL=

# ── Model routing ──────────────────────────────────────────────
# Fast model: role-play turns, hints, coach replies, scheduling, scenario generation
LLM_FAST_MODEL=claude-sonnet-5
# Smart model: post-practice assessment reports
LLM_SMART_MODEL=claude-opus-5
