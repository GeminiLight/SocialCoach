new file mode 100644
index 0000000000000000000000000000000000000000..e56b380aa922cc41c94200efc4e1f2bf84c3cf00
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,19 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Bound all public AST entry points,
+// including caller-supplied trees; do not recurse while validating a tree.
+module.exports = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  const seen = new WeakSet();
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 101 || seen.has(node)) {
+      throw new SyntaxError('Nesting depth exceeds limit (100)');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
