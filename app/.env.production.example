# 线上环境变量。复制成 .env.production 后填写（已被 .gitignore 覆盖）。

# ── 模型 ────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_API_KEY=
LLM_FAST_MODEL=glm-5.3-flash
LLM_SMART_MODEL=glm-5.3
LLM_OPENAI_THINKING=disabled

# ── 额度保护（公开部署必须认真设）──────────────────────
# 每 IP 每小时的调用次数。一场完整练习约 12–14 次。
RATE_LIMIT_PER_IP=45
# 全站每天的上限 —— 这才是保护钱包的那道线。
# 2000 ≈ 150 场练习/天。想更保守就调低。
RATE_LIMIT_GLOBAL_DAILY=2000
# NPC 语音每句一次请求，单独计数，不占对练额度。
RATE_LIMIT_SPEECH_PER_IP=240
RATE_LIMIT_SPEECH_GLOBAL_DAILY=10000
# 前方可信代理层数：从 X-Forwarded-For 右侧取第 N 个地址。Vercel / 自带 Caddy 为 1；
# 若外层还有 CDN 或平台代理（每层追加一个地址），按实际层数调大。左侧值由客户端决定，不可信。
TRUSTED_PROXY_HOPS=1

# 想让所有人都自带 key、你一分钱不花，就打开这个（届时上面的 LLM_API_KEY 可以留空）
# LLM_REQUIRE_BYOK=true

# Shared generation is disabled in production until its atomic budget is configured.
LLM_BUDGET_REDIS_URL=
LLM_BUDGET_REDIS_TOKEN=
LLM_BUDGET_DAILY_TOKENS=2000000
LLM_BUDGET_CONCURRENCY=8
